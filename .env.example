# Variables de entorno — MiHistorialMédico
#
# Copiar este archivo a .env.local y completar los valores reales.
# .env.example SÍ se versiona (sin secretos); .env.local NUNCA se versiona.
#
# Desarrollo local con Docker (Supabase local):
#   - URL local:  http://127.0.0.1:54321
#   - Las keys locales las muestra el comando: npx supabase status
#   - Mientras Docker Desktop no esté instalado, usar las credenciales del
#     proyecto remoto (Supabase Dashboard → Settings → API).

# --- Supabase ---

# URL del proyecto Supabase (remoto). Para desarrollo local con Docker,
# reemplazar por http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=https://nbypcqhojmixlxvkflrp.supabase.co

# Clave pública (anon key). Se puede exponer al cliente.
# Copiar de: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de rol de servicio (service role key).
# NUNCA exponer al cliente; usar solo en código de servidor (API routes,
# Server Actions, Route Handlers). Otorga acceso total, bypassea RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (Google AI) ---

# API key de Gemini. Obtener en Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a usar por defecto
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# --- Web Push (VAPID) ---
# Par de claves P-256 (RFC 8292). Se generan con:
#     node scripts/generar-vapid.mjs
# El script imprime las cuatro líneas listas para pegar en .env.local y en
# .env.development.local. Ver docs/push.md.
# OJO: regenerar el par invalida todas las suscripciones ya guardadas.

# Clave pública VAPID (par de claves para Web Push)
VAPID_PUBLIC_KEY=

# Clave privada VAPID — NUNCA exponer al cliente
VAPID_PRIVATE_KEY=

# Subject VAPID (contacto del remitente, formato mailto:)
VAPID_SUBJECT=mailto:contacto@historialmedico.com.ar

# La MISMA clave pública, expuesta al navegador: el cliente la necesita como
# applicationServerKey en pushManager.subscribe(). Es pública por diseño
# (viaja igual dentro del bundle), así que duplicarla acá no filtra nada.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Recordatorios de turnos (Sprint 6.4) ---
# Secreto compartido entre el job de pg_cron y el endpoint que drena la cola
# (POST /api/push/procesar-recordatorios). No es una clave de Supabase ni de
# Google: es un valor propio, largo y aleatorio. Generarlo con:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# El MISMO valor tiene que quedar cargado en el Vault de la base, junto con la
# URL a la que postear (ver docs/recordatorios.md §4):
#     select public.configurar_cron_recordatorios(
#         'http://host.docker.internal:3000/api/push/procesar-recordatorios',
#         '<el mismo CRON_SECRET>');
#
# Sin esta variable el endpoint responde 503 y no manda ningún recordatorio.
CRON_SECRET=
